# Which model answers as SupportBot: ollama (free, local), openai, or mock (offline, no model)
BACKEND=ollama

# Ollama (install from https://ollama.com, then: ollama pull llama3)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (only needed when BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# default = original system prompt, hardened = harden/hardened_prompt.py
PROMPT_PROFILE=default

REQUEST_TIMEOUT=120
